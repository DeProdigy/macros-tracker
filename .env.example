# Macros Tracker — environment variables
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# This file is the living contract for configuration — add every new var here
# as the project grows (see plans/09-deployment.md).

# ─── Django / backend (apps/api) ───────────────────────────────────────────────
# Which settings module loads. Unset locally (manage.py defaults to local);
# production.py is REQUIRED in Railway, or the app silently boots with dev
# settings — DEBUG on, no HTTPS enforcement, and the insecure fallback key.
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate a unique key per environment; never reuse the dev default in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Never True in production.
DJANGO_DEBUG=True
# Comma-separated; set explicitly in production. The Railway value must include
# `healthcheck.railway.app` — that is the Host header the platform's health
# probe sends, and ALLOWED_HOSTS rejects it otherwise, failing every deploy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres connection string. Local dev points at the Docker Compose Postgres;
# Railway injects this automatically once the Postgres service is linked, so
# never set it by hand there.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/macros_tracker

# HSTS tells browsers to refuse plain HTTP for this domain. Sticky and hard to
# roll back (browsers cache it), so it ships off and is ramped deliberately:
# 60 -> confirm nothing broke -> 31536000 (a year) -> only then subdomains ->
# preload. Leaving it at 0 in production is what `check --deploy` flags as W004.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ─── OpenAI (apps/api ai app) ──────────────────────────────────────────────────
# Vision for photo analysis, chat for target generation and advice.
OPENAI_API_KEY=
OPENAI_FOOD_ANALYSIS_MODEL=gpt-5-mini
# Update these rates when the configured model price changes. They affect audit estimates only.
OPENAI_FOOD_INPUT_USD_PER_MILLION=0.25
OPENAI_FOOD_OUTPUT_USD_PER_MILLION=2.00
# Paid provider calls admitted in the previous rolling 30 days. A reservation
# occupies a slot from admission until the call finalizes or this timeout passes.
FOOD_ANALYSIS_ROLLING_CALL_LIMIT=500
FOOD_ANALYSIS_RESERVATION_TIMEOUT_SECONDS=300

# ─── Cloudflare R2 object storage (food photos) ────────────────────────────────
# S3-compatible; bucket private, accessed via presigned URLs only. The API token
# must be scoped to this one bucket, never account-wide — if it leaks, the blast
# radius should be one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com; set only to
# override (R2 also issues per-bucket endpoints).
R2_ENDPOINT_URL=

# Presigned URL lifetimes, in seconds. A presigned URL is a bearer credential —
# anyone holding it has access until it expires — so these stay short. Uploads
# are seconds of work; reads may sit on screen in a list view.
R2_UPLOAD_URL_EXPIRY_SECONDS=300
R2_DOWNLOAD_URL_EXPIRY_SECONDS=3600

# Upload ceiling in bytes, enforced before anything is signed and then signed
# into the URL. Without it a client can PUT hundreds of megabytes and you pay to
# store something you never wanted. Default is 10MB.
R2_MAX_UPLOAD_BYTES=10485760

# ─── Transactional email ───────────────────────────────────────────────────────
# MVP is Sign in with Apple only (doc 04), so there is no verification or
# password-reset mail to send. Kept configured for Django's own error mail.
# Local dev uses Django's console backend and needs no provider account.
# In production set a real backend + provider key (Resend / Postmark / SES).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@macros-tracker.app
EMAIL_PROVIDER_API_KEY=

# ─── Sign in with Apple (auth) ─────────────────────────────────────────────────
# The iOS bundle identifier, and the expected `aud` claim on every identity
# token. This is the check that stops a valid Apple token minted for somebody
# else's app from authenticating here, so verification refuses to run at all
# when it is unset rather than comparing `aud` against an empty string.
# REQUIRED in production.
#
# Must match `expo.ios.bundleIdentifier` in apps/mobile/app.json and the App ID
# in the Apple Developer portal, character for character. A mismatch fails every
# sign-in with an audience error that looks nothing like a typo.
#
# NOT a Services ID. Apple issues those for *web* sign-in and most tutorials
# reach for one; a native iOS client's `aud` is always the bundle identifier.
#
# Sign in with Apple does not work in Expo Go, whose bundle identifier is
# `host.exp.Exponent`. Apple mints the token for *that*, so verification
# correctly rejects it. Testing on a device needs a development build.
APPLE_CLIENT_ID=com.hintology.macrostracker
# Unused by the MVP. These three are Apple's server-to-server credentials (token
# exchange, revocation). The native client hands us an identity token we verify
# locally against Apple's published public keys, so none of them is read.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Mobile (apps/mobile) ──────────────────────────────────────────────────────
# EXPO_PUBLIC_* vars are inlined into the client bundle — never put secrets here.
# This value covers `expo start` only. EAS builds read the per-profile `env`
# block in apps/mobile/eas.json instead, which points every profile at Railway —
# a build that fell back to this line would ship pointing at localhost and fail
# on device with no error worth reading.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SENTRY_DSN=

# ─── Developer tooling ─────────────────────────────────────────────────────────
# Personal Linear API key, used only by `pnpm sync:plans` to re-mirror the plan
# docs into plans/. Not a runtime dependency — nothing the app serves reads it.
# Create at Linear -> Settings -> Security & access:
#   https://linear.app/settings/account/security
# Read-only scope is enough; the script only runs a read query.
LINEAR_API_KEY=
