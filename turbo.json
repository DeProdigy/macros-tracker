{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:api": {
      // @macros/api-client depends on `api`, so ^generate:api runs Django's
      // schema emission before Orval consumes the resulting openapi.json.
      "dependsOn": ["^generate:api"],
      // Never cached. A stale hit would serve an out-of-date client, which is
      // precisely the drift this pipeline exists to prevent.
      "cache": false
    }
  }
}
