{
    "openapi": "3.0.3",
    "info": {
        "title": "Macros Tracker API",
        "version": "0.1.0",
        "description": "Typed contract consumed by apps/mobile via packages/api-client."
    },
    "paths": {
        "/api/health/": {
            "get": {
                "operationId": "health",
                "description": "Reports whether the API can serve traffic. Unlike `/api/ping/`, this executes a real query against the database and returns HTTP 503 if that query fails, so an orchestrator can pull the instance out of rotation. Requires no authentication.\n\nIntended for platform health probes rather than for clients.",
                "summary": "Deployment health check",
                "tags": [
                    "system"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                },
                                "examples": {
                                    "Healthy": {
                                        "value": {
                                            "status": "ok",
                                            "database": true,
                                            "version": "0.1.0",
                                            "timestamp": "2026-07-23T12:34:56Z"
                                        },
                                        "summary": "Database reachable",
                                        "description": "Every dependency check passed; the instance can serve traffic."
                                    }
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                },
                                "examples": {
                                    "Unhealthy": {
                                        "value": {
                                            "status": "unhealthy",
                                            "database": false,
                                            "version": "0.1.0",
                                            "timestamp": "2026-07-23T12:34:56Z"
                                        },
                                        "summary": "Database unreachable",
                                        "description": "The process is running but its query failed. Served with 503 so the platform treats the instance as unavailable."
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/ping/": {
            "get": {
                "operationId": "ping",
                "description": "Returns a small fixed-shape payload confirming the API is reachable and able to serialize a response. Requires no authentication and touches no database, so it is safe to call from an unauthenticated client and as a container health check.",
                "summary": "API liveness probe",
                "tags": [
                    "system"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Ping"
                                },
                                "examples": {
                                    "Healthy": {
                                        "value": {
                                            "status": "ok",
                                            "version": "0.1.0",
                                            "timestamp": "2026-07-23T12:34:56Z"
                                        },
                                        "summary": "Normal response",
                                        "description": "What a reachable API returns."
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/uploads/presign/": {
            "post": {
                "operationId": "presignUpload",
                "description": "Returns a short-lived presigned PUT URL and the object key the upload will land at.\n\nThe client uploads straight to object storage rather than through this API, so a slow mobile connection never occupies a server worker. The declared content type and length are signed into the URL: the subsequent PUT must match both exactly or storage rejects it.\n\nStore the returned `key` against the entry. The URL expires; the key does not.",
                "summary": "Authorise a direct photo upload",
                "tags": [
                    "uploads"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PresignUploadRequestRequest"
                            },
                            "examples": {
                                "A2MBJPEG": {
                                    "value": {
                                        "content_type": "image/jpeg",
                                        "content_length": 2097152
                                    },
                                    "summary": "Typical request",
                                    "description": "What the mobile client sends before uploading a camera photo."
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PresignUploadRequestRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PresignUploadRequestRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PresignUploadResponse"
                                },
                                "examples": {
                                    "SignedAuthorisation": {
                                        "value": {
                                            "url": "https://<account>.r2.cloudflarestorage.com/bucket/entries/1/...",
                                            "key": "entries/1/2f1c9e04-0d5c-4a51-9f0a-3b7c2e6a1d88.jpg",
                                            "expires_in": 300,
                                            "max_bytes": 10485760
                                        },
                                        "summary": "Successful response",
                                        "description": "`url` is a bearer credential valid for `expires_in` seconds. `key` is what gets persisted."
                                    }
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    },
                    "401": {
                        "description": "No response body"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Health": {
                "type": "object",
                "description": "Response body for the deployment health check.\n\nDistinct from `PingSerializer` on purpose. Ping answers \"is the process\nup?\"; health answers \"can this process actually serve a request?\", which\nmeans proving the database is reachable. They report different things and a\nshared shape would blur that.",
                "properties": {
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/HealthStatusEnum"
                            }
                        ],
                        "description": "`ok` when every dependency check passed, `unhealthy` otherwise. An `unhealthy` body is always served with HTTP 503, never 200.\n\n* `ok` - ok\n* `unhealthy` - unhealthy"
                    },
                    "database": {
                        "type": "boolean",
                        "description": "Whether a real query against the default database succeeded. This is an executed round-trip, not a check that settings are present."
                    },
                    "version": {
                        "type": "string",
                        "description": "API version string, mirroring SPECTACULAR_SETTINGS['VERSION']."
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Server time in UTC (ISO 8601) when the check was performed."
                    }
                },
                "required": [
                    "database",
                    "status",
                    "timestamp",
                    "version"
                ]
            },
            "HealthStatusEnum": {
                "enum": [
                    "ok",
                    "unhealthy"
                ],
                "type": "string",
                "description": "* `ok` - ok\n* `unhealthy` - unhealthy"
            },
            "Ping": {
                "type": "object",
                "description": "Response body for the API liveness probe.\n\nFields are declared explicitly (never `fields = \"__all__\"`) so the emitted\nOpenAPI schema is precise enough to generate useful client types from.",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Always `ok` when the API is reachable."
                    },
                    "version": {
                        "type": "string",
                        "description": "API version string, mirroring SPECTACULAR_SETTINGS['VERSION']."
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Server time in UTC (ISO 8601) when the request was handled."
                    }
                },
                "required": [
                    "status",
                    "timestamp",
                    "version"
                ]
            },
            "PresignUploadRequestRequest": {
                "type": "object",
                "description": "What the client must state before an upload is authorised.\n\nBoth fields are required. Letting either default would mean signing a URL\nwhose constraints the client never committed to, which is the same as not\nconstraining it.",
                "properties": {
                    "content_type": {
                        "type": "string",
                        "minLength": 1,
                        "description": "MIME type of the file about to be uploaded. Must be one of the supported image types; the PUT is rejected if it does not match."
                    },
                    "content_length": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Exact size in bytes of the file about to be uploaded. Signed into the URL, so the PUT must send precisely this many bytes."
                    }
                },
                "required": [
                    "content_length",
                    "content_type"
                ]
            },
            "PresignUploadResponse": {
                "type": "object",
                "description": "The signed authorisation handed back to the client.",
                "properties": {
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Presigned S3 PUT URL. Treat as a credential: anyone holding it can upload to this key until it expires."
                    },
                    "key": {
                        "type": "string",
                        "description": "Object key the upload will land at. Store this against the entry — it is the durable identifier, whereas the URL expires."
                    },
                    "expires_in": {
                        "type": "integer",
                        "description": "Seconds until the URL stops being accepted."
                    },
                    "max_bytes": {
                        "type": "integer",
                        "description": "Server-side upload ceiling, echoed so a client can fail fast locally instead of discovering it on a rejected PUT."
                    }
                },
                "required": [
                    "expires_in",
                    "key",
                    "max_bytes",
                    "url"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}