# Keep the build context small and the image reproducible. Anything listed here
# is either regenerated during the build, useless in a container, or must never
# reach a deployed image.

# Secrets — the whole point. Real values come from Railway's environment.
.env
.env.*
!.env.example

# Local virtualenv: built for macOS, and `uv sync` recreates it in the image.
.venv/

# Build output — collectstatic runs during the build.
staticfiles/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Tests and dev-only config: --no-dev means their dependencies are absent
# anyway, and they are never run from the production image.
tests/

# Version control and editor state.
.git/
.gitignore
.DS_Store
